{
 "uid": "ridehail-dispatch",
 "title": "Dispatch overview",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "tags": [
  "ridehail"
 ],
 "panels": [
  {
   "type": "stat",
   "title": "Rides created (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(rides_created_total[1h]))"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Offers accepted (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(offers_total{outcome=\"accepted\"}[1h]))"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Time to offer p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(dispatch_match_duration_seconds_bucket[5m])))"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Reservation conflicts (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(driver_reservation_conflicts_total[1h]))"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Outbox backlog",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(outbox_unpublished)"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Messages to DLQ (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(messages_consumed_total{outcome=\"dlq\"}[1h])) or vector(0)"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Offers by outcome /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(offers_total[1m]))",
     "legendFormat": "{{outcome}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Time to first offer",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(dispatch_match_duration_seconds_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(dispatch_match_duration_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     },
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "HTTP p95 by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_request_duration_seconds_bucket[5m])))",
     "legendFormat": "{{job}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     },
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Messages consumed /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (consumer, outcome) (rate(messages_consumed_total[1m]))",
     "legendFormat": "{{consumer}} {{outcome}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Outbox backlog by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job) (outbox_unpublished)",
     "legendFormat": "{{job}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "type": "logs",
   "title": "Ride timeline (filter by ride_id, driver_id or trace_id above)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 14
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service_name=~\"ride-service|driver-service|dispatch-service\"} | ride_id=~\"${ride_id:regex}\" | driver_id=~\"${driver_id:regex}\" | trace_id=~\"${trace_id:regex}\""
    }
   ],
   "options": {
    "showTime": true,
    "sortOrder": "Ascending",
    "enableLogDetails": true,
    "wrapLogMessage": true
   }
  }
 ],
 "templating": {
  "list": [
   {
    "name": "ride_id",
    "label": "ride_id",
    "type": "textbox",
    "query": "",
    "current": {
     "value": ".*",
     "text": ".*"
    }
   },
   {
    "name": "driver_id",
    "label": "driver_id",
    "type": "textbox",
    "query": "",
    "current": {
     "value": ".*",
     "text": ".*"
    }
   },
   {
    "name": "trace_id",
    "label": "trace_id",
    "type": "textbox",
    "query": "",
    "current": {
     "value": ".*",
     "text": ".*"
    }
   }
  ]
 }
}